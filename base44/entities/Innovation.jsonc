{
  "name": "Innovation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title of Innovation"
    },
    "author": {
      "type": "string",
      "title": "Author / Proponent"
    },
    "school": {
      "type": "string",
      "title": "School"
    },
    "district": {
      "type": "string",
      "title": "District"
    },
    "learning_focus": {
      "type": "string",
      "enum": [
        "numeracy",
        "literacy"
      ],
      "default": "numeracy",
      "title": "Learning Focus"
    },
    "key_stage": {
      "type": "string",
      "enum": [
        "KS1",
        "KS2",
        "KS3",
        "KS4"
      ],
      "default": "KS1",
      "title": "Key Stage"
    },
    "grade_levels": {
      "type": "string",
      "title": "Grade Levels"
    },
    "manuscript_file_url": {
      "type": "string",
      "title": "Manuscript File URL"
    },
    "summary": {
      "type": "string",
      "title": "AI-Generated Summary"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "evaluating",
        "evaluated",
        "validated",
        "scaling",
        "failed",
        "archived"
      ],
      "default": "submitted",
      "title": "Status"
    },
    "relevance_score": {
      "type": "number",
      "title": "Relevance & Responsiveness Score (0-100)"
    },
    "innovativeness_score": {
      "type": "number",
      "title": "Innovativeness Score (0-100)"
    },
    "effectiveness_score": {
      "type": "number",
      "title": "Effectiveness & Impact Score (0-100)"
    },
    "scalability_score": {
      "type": "number",
      "title": "Scalability & Replicability Score (0-100)"
    },
    "sustainability_score": {
      "type": "number",
      "title": "Sustainability Score (0-100)"
    },
    "documentation_score": {
      "type": "number",
      "title": "Quality of Documentation Score (0-100)"
    },
    "total_score": {
      "type": "number",
      "title": "Weighted Total Score (0-100)"
    },
    "ai_analysis": {
      "type": "string",
      "title": "Full AI Analysis"
    },
    "recommendation": {
      "type": "string",
      "title": "Recommendation"
    },
    "is_scalable": {
      "type": "boolean",
      "default": false,
      "title": "Determined Scalable"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Key Strengths"
    },
    "areas_for_improvement": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Areas for Improvement"
    },
    "ascend_stage": {
      "type": "string",
      "enum": [
        "identification",
        "validation",
        "readiness",
        "institutionalization",
        "scaling",
        "sustainability"
      ],
      "default": "identification",
      "title": "ASCEND Stage"
    },
    "evaluated_date": {
      "type": "string",
      "format": "date-time",
      "title": "Date Evaluated"
    },
    "validated_date": {
      "type": "string",
      "format": "date",
      "title": "Date Validated"
    }
  },
  "required": [
    "title",
    "learning_focus"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
